-- Existing content.
local existing = map:FindFirstChild("EnvSprint2")
local stray = {}
for _, d in workspace:GetDescendants() do
	if (d:GetAttribute("EnvSprint2") ~= nil or d:GetAttribute("EnvSprint2Category") ~= nil or string.find(d.Name, "^EnvSprint2")) and d ~= map and not (existing and (d == existing or d:IsDescendantOf(existing))) then
		table.insert(stray, d:GetFullName())
	end
end
if #stray > 0 then
	fail(string.format("%d EnvSprint2 instance(s) exist outside Map.EnvSprint2 (%s); nothing changed; run 9_rollback.luau first", #stray, table.concat(stray, ", ", 1, math.min(#stray, 6))))
end
if existing then
	local ok, why = matches(existing, GROUPS)
	if ok then
		if map:GetAttribute("EnvSprint2") ~= VERSION then
			fail("Map.EnvSprint2 matches the specification but the Map attribute reads " .. tostring(map:GetAttribute("EnvSprint2")))
		end
		local msg = string.format("ENV_SPRINT2 already built (%s); nothing changed", VERSION)
		_G.ENVSPRINT2_BUILD = { status = "done", result = msg }
		return msg
	end
	if #OLD_GROUPS == 0 then
		fail("Map.EnvSprint2 exists but differs from the " .. VERSION .. " specification (" .. why .. "); nothing changed; run 9_rollback.luau first")
	end
	local okOld, whyOld = matches(existing, OLD_SET)
	if not okOld then
		fail("Map.EnvSprint2 matches neither " .. VERSION .. " (" .. why .. ") nor the replaceable " .. REPLACES_VERSION .. " (" .. whyOld .. "); nothing changed")
	end
	if map:GetAttribute("EnvSprint2") ~= REPLACES_VERSION then
		fail("Map.EnvSprint2 matches " .. REPLACES_VERSION .. " but the Map attribute reads " .. tostring(map:GetAttribute("EnvSprint2")) .. "; nothing changed")
	end
	if not REPLACE_EXTERIOR then
		fail("Map.EnvSprint2 holds the " .. REPLACES_VERSION .. " exterior; this build only replaces it with REPLACE_EXTERIOR = true (use the replace/restore build); nothing changed")
	end

	-- Replacement. Budget: map now holds the old exterior; it leaves, the new one arrives.
	local p0, c0, l0 = mapCounts()
	local ext = used.SprintExterior
	local after = { p0 - oldExt[1] + ext[1], c0 - oldExt[2] + ext[2], l0 - oldExt[3] + ext[3] }
	if after[1] > MAP_CAP[1] or after[2] > MAP_CAP[2] or after[3] > MAP_CAP[3] then
		fail(string.format("map after replacement would be %d/%d/%d, cap %d/%d/%d; nothing changed", after[1], after[2], after[3], MAP_CAP[1], MAP_CAP[2], MAP_CAP[3]))
	end
	local staging = Instance.new("Folder")
	staging.Name = "EnvSprint2"
	local fresh = {}
	for _, g in NEW_EXTERIOR do
		local m = makeModel(g)
		m.Parent = staging
		table.insert(fresh, m)
	end
	local okNew, whyNew = matches(staging, NEW_EXTERIOR)
	if not okNew then
		staging:Destroy()
		fail("internal: freshly built exterior does not match its own specification (" .. whyNew .. "); nothing changed")
	end
	local oldModels = {}
	for _, g in OLD_GROUPS do
		table.insert(oldModels, existing:FindFirstChild(g.model) :: Instance)
	end
	-- Swap in one frame: no yield between clearing and setting the attribute.
	map:SetAttribute("EnvSprint2", nil)
	for _, m in oldModels do
		m:Destroy()
	end
	for _, m in fresh do
		m.Parent = existing
	end
	staging:Destroy()
	local okAll, whyAll = matches(existing, GROUPS)
	if not okAll then
		fail("replaced exterior differs from the specification (" .. whyAll .. "); Map attribute left CLEARED; run 9_rollback.luau then a fresh build")
	end
	map:SetAttribute("EnvSprint2", VERSION)
	local p1, c1, l1 = mapCounts()
	local msg = string.format("ENV_SPRINT2 exterior replaced (%s -> %s): traversal verified unchanged; SprintExterior %d/%d/%d -> %d/%d/%d; Map %d -> %d parts, %d -> %d collidable, %d -> %d lights", REPLACES_VERSION, VERSION, oldExt[1], oldExt[2], oldExt[3], ext[1], ext[2], ext[3], p0, p1, c0, c1, l0, l1)
	_G.ENVSPRINT2_BUILD = { status = "done", result = msg }
	return msg
end
if map:GetAttribute("EnvSprint2") ~= nil then
	fail("Map attribute EnvSprint2 is set but Map.EnvSprint2 is missing; run 9_rollback.luau first")
end

local p0, c0, l0 = mapCounts()
if p0 + sprint[1] > MAP_CAP[1] or c0 + sprint[2] > MAP_CAP[2] or l0 + sprint[3] > MAP_CAP[3] then
	fail(string.format("map after would be %d/%d/%d, cap %d/%d/%d; nothing changed", p0 + sprint[1], c0 + sprint[2], l0 + sprint[3], MAP_CAP[1], MAP_CAP[2], MAP_CAP[3]))
end

